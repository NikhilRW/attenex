{
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@/src/*": ["./src/*"],
      "@/features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@/app/*": ["./app/*"],
      "@auth/*": ["./src/features/Auth/*"],
      "@classes/*": ["./src/features/Classes/*"],
      "@attendance/*": ["./src/features/Attendance/*"],
      "@settings/*": ["./src/features/Settings/*"],
      "@role-selection/*": ["./src/features/RoleSelection/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
