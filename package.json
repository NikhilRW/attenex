{
  "name": "attenex",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun run --filter='./apps/*' build",
    "lint": "bun run --filter='./apps/*' lint",
    "typecheck": "bun run --filter='./apps/*' typecheck && bun run --filter='./packages/*' typecheck",
    "test": "bun run --filter='./apps/*' test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "prettier": ".prettierrc"
}
