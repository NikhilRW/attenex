{
  "name": "attenex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter='./apps/*' build",
    "lint": "bun run --filter='./apps/*' lint",
    "typecheck": "bun run --filter='./apps/*' typecheck && bun run --filter='./packages/*' typecheck",
    "test": "bun run --filter='./apps/*' test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "android": "bun run --filter='./apps/expo' android",
    "dev": "bun run --filter='./apps/api' dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "apps/expo/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/api/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "patchedDependencies": {
    "react-native-nitro-fetch@1.5.0": "patches/react-native-nitro-fetch@1.5.0.patch"
  }
}
